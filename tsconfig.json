{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting — AD-1 sicurezza dei tipi in strict */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /* Un solo progetto typecheck: copre l'app (DOM + vite/client) e i file di
       configurazione Node (vite/vitest). `node` sta nei types perché i config
       importano da 'node:*'; è innocuo per src, che non li usa. */
    "types": ["vite/client", "node"]
  },
  "include": ["src", "scripts", "vite.config.ts", "vitest.config.ts"]
}
