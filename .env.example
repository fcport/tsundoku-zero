# Tsundoku Zero — variabili di ambiente
#
# Questo file documenta i NOMI delle variabili, mai i valori.
# Copialo in .env e riempilo con i valori del tuo progetto Supabase.
# .env e' escluso da git; questo file no, ed e' voluto.
#
# Lo schema di validazione in src/app/ legge queste variabili all'avvio e
# fa fallire il boot se ne manca una, nominandola: l'applicazione non parte
# in uno stato parzialmente configurato (storia 1.2).

# URL del progetto Supabase — Dashboard > Project Settings > API
VITE_SUPABASE_URL=

# Chiave anonima (pubblicabile). E' pensata per stare nel bundle client:
# la difesa dei dati e' l'isolamento per riga (RLS), non la segretezza di
# questa chiave. Vedi AD-10.
VITE_SUPABASE_ANON_KEY=

# ----------------------------------------------------------------------
# Cosa NON va qui, e non e' una dimenticanza
# ----------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY non compare in questo file e non deve comparire
# in nessuna variabile VITE_*: il prefisso VITE_ finisce nel bundle servito
# al browser. La service_role vive solo nei secret del progetto Supabase e
# viene usata dalla sola Edge Function delete-account, che e' l'unico codice
# server del progetto (AD-11).
#
# I secret della CI (SUPABASE_ACCESS_TOKEN, SUPABASE_DB_PASSWORD,
# SUPABASE_PROJECT_REF) vivono nei GitHub Actions secrets, non qui.
